# ==============================================================================
# HelpLens Environment Configuration Template
# ==============================================================================

# Google Gemini API Key
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
# If left blank, HelpLens operates in high-fidelity "Smart Demo Mode" for hackathons!
GEMINI_API_KEY=

# Gemini Model Selection (default: gemini-3.8-flash)
# Options: gemini-3.8-flash, gemini-flash-latest, gemini-2.5-flash
GEMINI_MODEL=gemini-3.8-flash

# Flask Secret Key for session security
SECRET_KEY=helplens-hackathon-secure-key-2026

# Database Storage (SQLite: zero external setup required)
USE_DATABASE=true

# Server Settings
HOST=0.0.0.0
PORT=5000
DEBUG=false

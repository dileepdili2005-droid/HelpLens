# Google Gemini API Key
# If left blank, HelpLens operates in high-fidelity "Smart Demo Mode" for hackathons!
GEMINI_API_KEY=

# Gemini Model Selection
GEMINI_MODEL=gemini-3.8-flash

# Flask Secret Key
SECRET_KEY=helplens-hackathon-secure-key-2026

# Database Storage
USE_DATABASE=true

# Server Settings
HOST=127.0.0.1
PORT=5000
DEBUG=false
